---
import { Image } from 'astro:assets';
import { copy, type Project } from '../data/portfolio';
import { imageSource } from '../lib/images';
import Icon from './Icon.astro';
interface Props { project: Project }
const { project } = Astro.props;
---
<div class="thumbnail">
  {project.image ? <Image src={imageSource(project.image.file)} alt={project.image.alt}
    widths={[320, 480, 640, 840]} sizes="(max-width:639px) calc(100vw - 48px), (max-width:1023px) 45vw, (max-width:1439px) 31vw, 412px"
    format="webp" quality={86} loading="lazy" decoding="async" /> :
    <span class="preview-label mono"><Icon name="image" />{copy.preview}</span>}
</div>
<style is:global>
.thumbnail { display:grid; place-items:center; aspect-ratio:16/9; width:100%; overflow:clip; position:relative; background:var(--p-surface); }
.thumbnail > img { width:100%; height:100%; object-fit:contain; display:block; }
.preview-label { display:inline-flex; align-items:center; gap:var(--s-2); color:var(--p-muted); }
</style>
