---
import { person, copy, nav, projects, folio } from '../data/portfolio';
import { local, projectHref } from '../lib/paths';
import Icon from './Icon.astro';
interface Props { home: boolean }
const { home } = Astro.props;
const prefix = home ? '' : local();
---
<header class="nav" aria-label={copy.portfolio}>
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">{copy.ui.skip}</a>
    <a class="nav__logo brand" href={`${prefix}#top`} aria-label={`${person.initials} ${person.name} · ${copy.portfolio}`}>
      <span class="mark mark--initial" aria-hidden="true">{person.initials}</span>
      <span class="brand-info"><strong>{person.name}</strong></span>
    </a>
    <span class="brand-descriptor">{copy.portfolio}</span>
    <nav class="nav__links" id="navigation" aria-label={copy.ui.navigation}>
      {nav.map(item => <div class="nav__item">
        <a class="nav__link" href={`${prefix}#${item.id}`}>{item.label}</a>
        {item.id === 'projects' && <div class="nav__menu"><div class="wrap grid">{projects.map((p, i) => <a class="menu-project span-4" href={projectHref(p.slug)}><span class="mono">{folio(i+1)}</span>{p.title}</a>)}</div></div>}
      </div>)}
      <div class="mobile-profile"><span class="availability"><i class="pip"></i>{copy.availability}</span><span>{person.university}</span></div>
    </nav>
    <div class="nav__end">
      <span class="availability"><i class="pip"></i>{copy.availability}</span>
      <button class="icon-button theme-control" type="button" role="switch" aria-checked="false" aria-label={copy.ui.theme} title={copy.ui.theme}><Icon name="moon" class="moon" /><Icon name="sun" class="sun" /></button>
      <button class="nav__toggle" type="button" aria-label={copy.ui.menu} aria-expanded="false" aria-controls="navigation"><Icon name="menu" class="open-menu" /><Icon name="x" class="close-menu" /></button>
    </div>
  </div>
</header>
