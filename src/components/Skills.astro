---
import { copy, technicalSkills, toolkit, folio } from '../data/portfolio';
import { toolIcon } from '../lib/paths';
import SectionTitle from './SectionTitle.astro';
import Icon from './Icon.astro';
const glyphs = ['filter','chart-line','chart-area','layers','target','workflow','panel-top','table','file-text'];
---
<section class="section skills-section ground-inverse" id="skills" aria-labelledby="skills-title">
  <div class="wrap">
    <SectionTitle title={copy.skills} id="skills" label={copy.ui.capabilities} />
    <div class="grid skill-groups">
      <div class="card m-nolift skill-group span-7"><div class="group-heading"><h3>{copy.technical}</h3><span class="mono" aria-hidden="true">{folio(technicalSkills.length)}</span></div>
        <ul class="skill-list">{technicalSkills.map((name,i)=><li><Icon name={glyphs[i] ?? 'layers'} /><span>{name}</span></li>)}</ul>
      </div>
      <div class="card m-nolift skill-group span-5"><div class="group-heading"><h3>{copy.technologies}</h3><span class="mono" aria-hidden="true">{folio(toolkit.length)}</span></div>
        <ul class="tool-list">{toolkit.map(t=><li><span class="tool-icon ic-tile"><img class="ic" src={toolIcon(t.icon)} data-icon={t.icon} width="32" height="32" alt="" loading="lazy" decoding="async" /></span><span>{t.name}</span></li>)}</ul>
      </div>
    </div>
  </div>
</section>
<style>
.skills-section { --bg: var(--band); --ink: var(--band-ink); --surface: var(--band-surface); --muted: var(--band-muted); background: var(--bg); color: var(--ink); --line: color-mix(in srgb,var(--ink) 17%,transparent); }
.skill-groups { margin-top: var(--head-gap); }
.skill-group { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: var(--s-6); display: flex; flex-direction: column; }
.group-heading { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-3); padding-bottom: var(--s-5); border-bottom: 1px solid var(--line); }
.group-heading .mono { color: var(--muted); }
.skill-list,.tool-list { margin: 0; padding: 0; list-style: none; }
.skill-list { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 0 var(--s-5); flex: 1; }
.skill-list li { display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-start; gap: var(--s-3); padding-block: var(--s-5); border-bottom: 1px solid var(--line); font-size: var(--t-body); line-height: 1.45; }
.skill-list li:nth-last-child(-n+3) { border: 0; padding-bottom: 0; }
.skill-list li :global(.ui-icon) { width: 23px; height: 23px; color: var(--blue-top); }
.tool-list { display: grid; flex: 1; }
.tool-list li { display: flex; align-items: center; gap: var(--s-5); padding-block: var(--s-4); border-bottom: 1px solid var(--line); color: var(--ink); font-size: var(--t-lead); }
.tool-list li:last-child { border: 0; padding-bottom: 0; }
.tool-icon { display: grid; place-items: center; width: 48px; height: 48px; background: var(--sheet); border-radius: var(--r-md); flex: none; }
.tool-icon img { object-fit: contain; }
@media(min-width: 1024px) and (min-height:800px) { .skill-group { min-height: min(56svh,530px); } }
@media(640px <= width < 1024px) { .skill-groups { grid-template-columns: 1fr; }.skill-group { grid-column:1 / -1; }.tool-list { grid-template-columns: repeat(2,1fr); column-gap: var(--s-5); }.tool-list li:nth-last-child(2) {border: 0;} }
@media(max-width:639px) { .skill-group { padding: var(--s-5); }.group-heading { padding-bottom: var(--s-4); }.group-heading h3 { font-size: 22px; }.skill-list { grid-template-columns: 1fr 1fr; gap: 0 var(--s-4); }.skill-list li { padding-block: var(--s-4); }.skill-list li:nth-last-child(3) { border-bottom:1px solid var(--line); }.tool-list li { gap: var(--s-4); }.tool-icon { width: 40px; height: 40px; }.tool-icon img {width: 25px; height: 25px;} }
@media(min-width:1024px) and (max-height:740px) { main > .skills-section {height: auto; min-height: 100svh;} }

@media(max-width:639px) {
  .skill-groups { margin-top:var(--s-5);gap:var(--s-4); }
  .skill-group {padding:var(--s-4);}
  .group-heading {padding-bottom:var(--s-3);}
  .skill-list {gap:0 var(--s-3);}
  .skill-list li,.skill-list li:nth-last-child(-n+3) {flex-direction:row;align-items:baseline;gap:var(--s-2);padding-block:var(--s-2);font-size:var(--t-body);line-height:1.38;}
  .skill-list li :global(.ui-icon) {width:14px;height:14px;}
  .tool-list {grid-template-columns:1fr 1fr;column-gap:var(--s-3);}
  .tool-list li {padding-block:var(--s-3);gap:var(--s-2);font-size:var(--t-body);}
  .tool-list li:nth-last-child(2) {border-bottom:0;}
  .tool-icon {width:30px;height:30px;}.tool-icon img {width:22px;height:22px;}
}
</style>
