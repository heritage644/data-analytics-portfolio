---
import Page from '../../layouts/Page.astro';
import { copy, projects, person } from '../../data/portfolio';
import { local } from '../../lib/paths';
import CaseStudy from '../../components/CaseStudy.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
export function getStaticPaths() { return projects.map((project,i)=>({params:{slug:project.slug},props:{project,number:i+1}})); }
const {project, number}=Astro.props;
---
<Page title={`${project.title} | ${person.name}`} description={project.overview.split('. ')[0]+'.'}>
  <main id="top" class="case-page" tabindex="-1"><div class="wrap"><a class="back-link m-link" href={local('#projects')}><Icon name="arrow-left" />{copy.ui.back}</a>
    <CaseStudy project={project} number={number} />
  </div></main><Footer compact />
</Page>
<style>
.case-page {padding:calc(var(--nav) + var(--s-6)) 0 var(--s-8);}.back-link {display:inline-flex;align-items:center;gap:var(--s-2);min-height:44px;font-size:var(--t-small);margin-bottom:var(--s-5);}
.case-page :global(.study) {border:1px solid var(--line-strong);border-radius:var(--r-lg);overflow:clip;max-width:960px;margin:0 auto;}
</style>
